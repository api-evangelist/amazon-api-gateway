{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon API Gateway REST API Keys Documentation API",
    "version": "2015-07-09"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Documentation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon API Gateway List Documentation Parts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apigateway.{region}.amazonaws.com/restapis/:restapi_id/documentation/parts",
            "params": [
              {
                "name": "restapi_id",
                "value": "",
                "type": "path",
                "description": "The identifier of the REST API."
              },
              {
                "name": "position",
                "value": "",
                "type": "query",
                "description": "The current pagination position in the paged result set. Used for cursor-based pagination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of returned results per page. The default value is 25 and the maximum value is 500."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by documentation part type."
              },
              {
                "name": "nameQuery",
                "value": "",
                "type": "query",
                "description": "Filter by name."
              },
              {
                "name": "path",
                "value": "",
                "type": "query",
                "description": "Filter by resource path."
              }
            ]
          },
          "docs": "Returns documentation parts for a REST API."
        },
        {
          "info": {
            "name": "Amazon API Gateway Create a Documentation Part",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apigateway.{region}.amazonaws.com/restapis/:restapi_id/documentation/parts",
            "params": [
              {
                "name": "restapi_id",
                "value": "",
                "type": "path",
                "description": "The identifier of the REST API."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a documentation part for a REST API."
        },
        {
          "info": {
            "name": "Amazon API Gateway List Documentation Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apigateway.{region}.amazonaws.com/restapis/:restapi_id/documentation/versions",
            "params": [
              {
                "name": "restapi_id",
                "value": "",
                "type": "path",
                "description": "The identifier of the REST API."
              },
              {
                "name": "position",
                "value": "",
                "type": "query",
                "description": "The current pagination position in the paged result set. Used for cursor-based pagination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of returned results per page. The default value is 25 and the maximum value is 500."
              }
            ]
          },
          "docs": "Returns documentation versions for a REST API."
        },
        {
          "info": {
            "name": "Amazon API Gateway Create a Documentation Version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apigateway.{region}.amazonaws.com/restapis/:restapi_id/documentation/versions",
            "params": [
              {
                "name": "restapi_id",
                "value": "",
                "type": "path",
                "description": "The identifier of the REST API."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a snapshot of the documentation for a REST API."
        }
      ]
    }
  ],
  "bundled": true
}